{
  "name": "qbminimal",
  "description": "A minimal, phone-friendly Web UI for qBittorrent",
  "version": "1.4.11",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kajover/qbminimal.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "scripts/deploy.sh",
    "preview": "vite preview",
    "release": "tsc -b && vite build --outDir release/public --emptyOutDir",
    "demo": "VITE_DEMO_MODE=true npm run dev",
    "demo:build": "VITE_DEMO_MODE=true vite build",
    "package": "npm run release && rm -rf .pkg qbminimal-release.zip && mkdir -p .pkg/qbminimal && cp -R release/public .pkg/qbminimal/ && cp LICENSE README.md THIRD_PARTY_NOTICES.md src/assets/fonts/Silkscreen-OFL.txt .pkg/qbminimal/ && (cd .pkg && zip -qr ../qbminimal-release.zip qbminimal) && rm -rf .pkg",
    "i18n:check": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "0.1.10",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.15",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
