{
  "name": "qbminimal",
  "description": "A minimal, phone-friendly Web UI for qBittorrent",
  "version": "1.5.2",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kajover/qbminimal.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-native/bin/tsc -b",
    "test": "vitest run",
    "deploy": "scripts/deploy.sh",
    "preview": "vite preview",
    "release": "npm run typecheck && vite build --outDir release/public --emptyOutDir",
    "demo": "VITE_DEMO_MODE=true npm run dev",
    "demo:build": "VITE_DEMO_MODE=true vite build",
    "package": "npm run release && rm -rf .pkg qbminimal-release.zip && mkdir -p .pkg/qbminimal && cp -R release/public .pkg/qbminimal/ && cp LICENSE README.md THIRD_PARTY_NOTICES.md src/assets/fonts/Silkscreen-OFL.txt .pkg/qbminimal/ && (cd .pkg && zip -qr ../qbminimal-release.zip qbminimal) && rm -rf .pkg",
    "i18n:check": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "0.1.10",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
